# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# GiantGreen EcoTech Contact & Booking Configuration (Client-Safe)
# ==============================================================================
VITE_WHATSAPP_NUMBER="60123629153"
VITE_PHONE_DISPLAY="+60 123629153"
VITE_CONTACT_EMAIL="giantgreenecotech@ggetapp.com"

# Optional external booking scheduling URL (e.g., Google Calendar Appointment Scheduling or Calendly)
# Leave empty if no scheduling page is active; buttons will guide users to /contact
VITE_GOOGLE_BOOKING_URL=""

# ==============================================================================
# Supabase Client Auth Config (Public Anon Key ONLY - Safe for Browser)
# Used exclusively by /admin/login and /admin for administrator sign-in
# ==============================================================================
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ==============================================================================
# Supabase Server Config (SERVER-SIDE ONLY - NEVER prefix with VITE_)
# Used by Express server.ts for validated writes, rate limiting, and admin APIs
# ==============================================================================
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Comma-separated list of authorized administrator emails allowed into /admin
# Example: "giantgreenecotech@ggetapp.com,admin@yourdomain.com"
ADMIN_ALLOWED_EMAILS="giantgreenecotech@ggetapp.com"

# ==============================================================================
# Server-side Transactional Email Notification (Resend - SERVER-SIDE ONLY)
# ==============================================================================
NOTIFICATION_EMAIL="giantgreenecotech@ggetapp.com"
RESEND_API_KEY=""
EMAIL_FROM="GiantGreen EcoTech <onboarding@resend.dev>"
